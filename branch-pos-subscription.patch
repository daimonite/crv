 /**
- * Activates (or extends) an account subscription after Payme confirmation.
+ * Sums a branch's current stock value (quantity × sale price across all its
+ * batches) — this is the metric the desktop POS subscription (a separate,
+ * branch-level plan from the pharmacy portal's account-level plans above) is
+ * priced against.
+ */
+export async function computeBranchStockValueTzs(service: SupabaseClient, branchId: string): Promise<number> {
+  const { data, error } = await service.from("batches").select("quantity, sale_price").eq("branch_id", branchId);
+  if (error || !data) return 0;
+  return data.reduce((sum, b) => sum + Number(b.quantity || 0) * Number(b.sale_price || 0), 0);
+}
+
+export interface BranchSubscriptionPlan {
+  id: string;
+  name: string;
+  price_monthly_tzs: number;
+  price_annual_tzs: number;
+  max_stock_value_tzs: number | null;
+  features: string[] | null;
+}
+
+export async function getBranchPlans(
+  service: SupabaseClient,
+  planId?: string
+): Promise<{ data: BranchSubscriptionPlan[] | null; error: string | null }> {
+  let query = service
+    .from("branch_subscription_plans")
+    .select("id, name, price_monthly_tzs, price_annual_tzs, max_stock_value_tzs, features")
+    .order("price_monthly_tzs", { ascending: true });
+  if (planId) query = query.eq("id", planId);
+  const { data, error } = await query;
+  if (error) return { data: null, error: error.message };
+  return { data: data as BranchSubscriptionPlan[] | null, error: null };
+}
+
+/** The cheapest plan whose stock-value ceiling still covers this branch's current stock value. */
+export function suggestBranchPlan(plans: BranchSubscriptionPlan[], stockValueTzs: number): BranchSubscriptionPlan | null {
+  const sorted = [...plans].sort((a, b) => a.price_monthly_tzs - b.price_monthly_tzs);
+  return sorted.find((p) => p.max_stock_value_tzs == null || stockValueTzs <= p.max_stock_value_tzs) ?? sorted[sorted.length - 1] ?? null;
+}
+
+/**
+ * Records intent + triggers a Payme collection for a branch's POS plan.
+ * Mirrors createSubscriptionCheckout but writes branch_subscription_payments
+ * and uses a BRSUB- reference prefix so the webhook can route it correctly
+ * (distinct from the account-level SUB- prefix).
+ */
+export async function createBranchSubscriptionCheckout(args: {
+  service: SupabaseClient;
+  branchId: string;
+  plan: BranchSubscriptionPlan;
+  months?: number;
+  msisdn?: string;
+}): Promise<SubscriptionCheckoutResult> {
+  const { service, branchId, plan, msisdn } = args;
+  const months = Math.max(1, Math.floor(args.months ?? 1));
+  const amountTzs = plan.price_monthly_tzs * months;
+  const reference = `BRSUB-${Date.now().toString(36).toUpperCase()}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`;
+  const wallet = (msisdn ?? "").trim();
+
+  const { data: branch } = await service.from("branches").select("account_id").eq("id", branchId).single();
+  if (!branch) return { reference: null, message: null, error: "Branch not found." };
+
+  const { error: payInsertError } = await service.from("payments").insert({
+    account_id: branch.account_id,
+    reference,
+    amount_tzs: amountTzs,
+    msisdn: wallet || null,
+    status: "pending",
+    provider: "payme",
+  });
+  if (payInsertError) return { reference: null, message: null, error: payInsertError.message };
+
+  const { error: subInsertError } = await service.from("branch_subscription_payments").insert({
+    branch_id: branchId,
+    plan_id: plan.id,
+    amount_tzs: amountTzs,
+    reference,
+    months,
+    status: "pending",
+  });
+  if (subInsertError) {
+    await service.from("payments").update({ status: "failed", failure_reason: subInsertError.message }).eq("reference", reference);
+    return { reference: null, message: null, error: subInsertError.message };
+  }
+
+  const { initiateCollection } = await import("@/lib/payme");
+  const appUrl = process.env.NEXT_PUBLIC_APP_URL || "http://localhost:3000";
+  const { data: paymeData, error: paymeError } = await initiateCollection({
+    amount: amountTzs,
+    msisdn: wallet,
+    reference,
+    callback_url: `${appUrl}/api/webhooks/payme`,
+  });
+
+  if (paymeError) {
+    await service.from("payments").update({ status: "failed", failure_reason: paymeError }).eq("reference", reference);
+    await service.from("branch_subscription_payments").update({ status: "failed", failure_reason: paymeError }).eq("reference", reference);
+    return { reference, message: null, error: paymeError };
+  }
+
+  const completed = paymeData?.payment_status === "COMPLETED";
+  await service.from("payments").update({
+    provider_transaction_id: paymeData?.transaction_id || null,
+    status: completed ? "completed" : "pending",
+    completed_at: completed ? new Date().toISOString() : null,
+  }).eq("reference", reference);
+
+  if (completed) {
+    await activateBranchSubscription({ service, reference });
+  }
+
+  return {
+    reference,
+    message: completed
+      ? "Payment confirmed — this branch's POS subscription is active."
+      : "Payment initiated — confirm the mobile money prompt to activate.",
+    error: null,
+  };
+}
+
+/**
+ * Activates (or extends) a single branch's POS subscription after Payme
+ * confirmation. Unlike activateSubscription (account-level, ripples to every
+ * branch), this touches only the one branch tied to the payment reference —
+ * a pharmacy with 3 branches can have 3 independently-priced POS plans.
+ */
+export async function activateBranchSubscription(args: {
+  service: SupabaseClient;
+  reference: string;
+}): Promise<{ ok: boolean; message: string }> {
+  const { service, reference } = args;
+
+  const { data: subPayment, error: fetchError } = await service
+    .from("branch_subscription_payments")
+    .select("id, branch_id, plan_id, months, status, expires_at, branch_subscription_plans(id, name)")
+    .eq("reference", reference)
+    .single();
+
+  if (fetchError || !subPayment) return { ok: false, message: "Branch subscription payment not found." };
+
+  if (subPayment.status === "confirmed" && subPayment.expires_at && new Date(subPayment.expires_at).getTime() > Date.now()) {
+    return { ok: true, message: "Already active." };
+  }
+
+  const plan = subPayment.branch_subscription_plans as unknown as { id: string; name: string } | null;
+
+  const { data: branch } = await service.from("branches").select("id, subscription_expires_at").eq("id", subPayment.branch_id).single();
+
+  const nowMs = Date.now();
+  const existing = branch?.subscription_expires_at ? new Date(branch.subscription_expires_at).getTime() : 0;
+  const baseMs = Math.max(nowMs, existing);
+  const months = Math.max(1, subPayment.months ?? 1);
+  const newExpires = new Date(baseMs + months * 30 * 24 * 60 * 60 * 1000);
+
+  const { error: subUpdateError } = await service
+    .from("branch_subscription_payments")
+    .update({ status: "confirmed", activated_at: new Date().toISOString(), expires_at: newExpires.toISOString(), updated_at: new Date().toISOString() })
+    .eq("id", subPayment.id);
+  if (subUpdateError) return { ok: false, message: subUpdateError.message };
+
+  const { error: branchError } = await service
+    .from("branches")
+    .update({
+      subscription_status: "active",
+      subscription_tier: plan?.name ?? null,
+      subscription_expires_at: newExpires.toISOString(),
+      grace_ends_at: null,
+    })
+    .eq("id", subPayment.branch_id);
+  if (branchError) return { ok: false, message: branchError.message };
+
+  return { ok: true, message: "Branch POS subscription activated." };
+}
